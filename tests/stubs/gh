#!/usr/bin/env bash
set -euo pipefail

printf 'gh' >> "${GH_STRATADIFF_TEST_LOG}"
for argument in "$@"; do
  printf ' %q' "${argument}" >> "${GH_STRATADIFF_TEST_LOG}"
done
printf '\n' >> "${GH_STRATADIFF_TEST_LOG}"

scenario=${GH_STRATADIFF_TEST_SCENARIO}
command_name=${1:-}
shift || true

case "${command_name}" in
  release)
    subcommand=${1:-}
    shift || true
    case "${subcommand}" in
      view)
        case "${scenario}" in
          mutable-release) printf 'v0.4.0\tfalse\tfalse\tfalse\n' ;;
          draft-release) printf 'v0.4.0\ttrue\tfalse\ttrue\n' ;;
          prerelease) printf 'v0.4.0\tfalse\ttrue\ttrue\n' ;;
          *) printf 'v0.4.0\tfalse\tfalse\ttrue\n' ;;
        esac
        ;;
      *) printf 'unsupported gh release subcommand: %s\n' "${subcommand}" >&2; exit 2 ;;
    esac
    ;;
  api)
    endpoint=
    jq_filter=
    previous=
    for argument in "$@"; do
      if [[ "${previous}" == --jq ]]; then
        jq_filter=${argument}
        previous=
        continue
      fi
      if [[ "${previous}" == -H || "${previous}" == --hostname ]]; then
        previous=
        continue
      fi
      case "${argument}" in
        -H|--hostname|--jq) previous=${argument} ;;
        -*) ;;
        *) endpoint=${argument} ;;
      esac
    done
    case "${endpoint}" in
      repos/gcomfident-crypto/stratadiff/git/ref/tags/v0.4.0)
        if [[ "${scenario}" == invalid-tag-object ]]; then
          printf 'tag\tnot-a-sha\n'
        else
          printf 'tag\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n'
        fi
        ;;
      repos/gcomfident-crypto/stratadiff/git/tags/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)
        count=0
        if [[ -f "${GH_STRATADIFF_TEST_STATE}" ]]; then
          count="$(< "${GH_STRATADIFF_TEST_STATE}")"
        fi
        count=$((count + 1))
        printf '%s\n' "${count}" > "${GH_STRATADIFF_TEST_STATE}"
        if [[ "${scenario}" == tag-drift && "${count}" -ge 2 ]]; then
          printf 'commit\tdddddddddddddddddddddddddddddddddddddddd\n'
        else
          printf 'commit\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
        fi
        ;;
      repos/gcomfident-crypto/stratadiff/contents/scripts/install-release.sh\?ref=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)
        if [[ "${scenario}" != empty-installer ]]; then
          /bin/cat "${GH_STRATADIFF_TEST_INSTALLER}"
        fi
        ;;
      repos/gcomfident-crypto/gh-stratadiff/immutable-releases)
        if [[ "${scenario}" == immutable-disabled ]]; then
          printf 'false\n'
        else
          printf 'true\n'
        fi
        ;;
      repos/gcomfident-crypto/gh-stratadiff/rulesets)
        case "${scenario}" in
          missing-ruleset) printf '\n' ;;
          duplicate-ruleset) printf '42\n43\n' ;;
          *) printf '42\n' ;;
        esac
        ;;
      repos/gcomfident-crypto/gh-stratadiff/rulesets/42)
        [[ -z "${jq_filter}" ]] || exit 2
        case "${scenario}" in
          invalid-ruleset)
            printf '%s\n' '{"name":"Protect immutable v* release tags","target":"branch","enforcement":"active","bypass_actors":[],"conditions":{"ref_name":{"include":["refs/tags/v*"],"exclude":[]}},"rules":[{"type":"deletion"},{"type":"update"}]}'
            ;;
          missing-bypass-actors)
            printf '%s\n' '{"name":"Protect immutable v* release tags","target":"tag","enforcement":"active","conditions":{"ref_name":{"include":["refs/tags/v*"],"exclude":[]}},"rules":[{"type":"deletion"},{"type":"update"}]}'
            ;;
          null-bypass-actors)
            printf '%s\n' '{"name":"Protect immutable v* release tags","target":"tag","enforcement":"active","bypass_actors":null,"conditions":{"ref_name":{"include":["refs/tags/v*"],"exclude":[]}},"rules":[{"type":"deletion"},{"type":"update"}]}'
            ;;
          extra-bypass-actors)
            printf '%s\n' '{"name":"Protect immutable v* release tags","target":"tag","enforcement":"active","bypass_actors":[{"actor_id":1,"actor_type":"RepositoryRole","bypass_mode":"always"}],"conditions":{"ref_name":{"include":["refs/tags/v*"],"exclude":[]}},"rules":[{"type":"deletion"},{"type":"update"}]}'
            ;;
          *)
            printf '%s\n' '{"name":"Protect immutable v* release tags","target":"tag","enforcement":"active","bypass_actors":[],"conditions":{"ref_name":{"include":["refs/tags/v*"],"exclude":[]}},"rules":[{"type":"deletion"},{"type":"update"}]}'
            ;;
        esac
        ;;
      *) printf 'unsupported gh api endpoint: %s\n' "${endpoint}" >&2; exit 2 ;;
    esac
    ;;
  attestation)
    [[ "${1:-}" == verify ]] || exit 2
    [[ "${scenario}" != attestation-failure ]] || exit 1
    ;;
  *) printf 'unsupported gh command: %s\n' "${command_name}" >&2; exit 2 ;;
esac
